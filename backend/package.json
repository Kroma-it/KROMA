{
  "name": "kroma-backend",
  "version": "1.0.0",
  "description": "Backend API for KROMA Agency",
  "main": "dist/api.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && npx esbuild src/app.ts --bundle --platform=node --target=node18 --outfile=dist/api.js --external:@prisma/client --external:.prisma/client --format=cjs",
    "start": "node dist/api.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "esbuild": "^0.24.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
