{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/api.js",
      "use": "@vercel/node",
      "config": {
        "bundle": false,
        "includeFiles": [
          "dist/api.js",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/api.js"
    }
  ]
}
